{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NDI Vision Control",
  "version": "1.6.0",
  "identifier": "local.ndi.vision-control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NDI Vision Control V1.6",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 660
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
